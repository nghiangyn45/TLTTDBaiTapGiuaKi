<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121824"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ THÔNG TIN NHÂN VIÊN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Yêu cầu 6.3: Hiển thị tên viết hoa[cite: 38] -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvEmployeeId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvAgeAndGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:layout_marginBottom="6dp" />

                <!-- Yêu cầu 6.2: Hiển thị lương với định dạng đặc biệt[cite: 38] -->
                <TextView
                    android:id="@+id/tvSalary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#38BDF8"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Yêu cầu 6.1: Hiển thị mức lương trên số chuẩn[cite: 38] -->
                <TextView
                    android:id="@+id/tvSalaryComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FBBF24"
                    android:layout_marginBottom="6dp" />

                <!-- Yêu cầu 6.5: Hiển thị mức xếp loại dựa trên thâm niên[cite: 38] -->
                <TextView
                    android:id="@+id/tvSeniorityRank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4ADE80"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Yêu cầu 6.4: Hiển thị thông tin nhân viên bằng Extension Function[cite: 38] -->
                <TextView
                    android:id="@+id/tvSummaryInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#A78BFA"
                    android:layout_marginBottom="6dp" />

                <!-- Yêu cầu 6.6: Bổ sung một thông tin vào giao diện[cite: 38] -->
                <TextView
                    android:id="@+id/tvExtraInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#34D399" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>